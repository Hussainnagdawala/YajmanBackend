--
-- Name: services; Type: TABLE; Schema: public; Owner: -
--

CREATE TABLE public.services (
    id uuid DEFAULT public.uuid_generate_v4() NOT NULL,
    title character varying(200) NOT NULL,
    slug character varying(250) NOT NULL,
    category_id uuid NOT NULL,
    type_id uuid,
    price numeric(10,2),
    original_price numeric(10,2),
    discount_percent integer,
    short_description text,
    about_puja text,
    description text,
    custom_content text,
    pincode character varying(10),
    latitude numeric(10,7),
    longitude numeric(10,7),
    feature_image_url text NOT NULL,
    video_url text,
    duration_minutes integer,
    advance_booking_days integer DEFAULT 0,
    is_active boolean DEFAULT true,
    is_featured boolean DEFAULT false,
    is_bestseller boolean DEFAULT false,
    meta_title character varying(200),
    meta_description text,
    rating_avg numeric(3,2) DEFAULT 0.00,
    total_reviews integer DEFAULT 0,
    total_bookings integer DEFAULT 0,
    view_count integer DEFAULT 0,
    display_order integer DEFAULT 0,
    status public.content_status DEFAULT 'published'::public.content_status,
    created_by uuid,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    is_addon_available boolean DEFAULT false NOT NULL,
    benefits text[] DEFAULT '{}'::text[] NOT NULL,
    key_features text[] DEFAULT '{}'::text[] NOT NULL,
    availability_start_date date,
    availability_end_date date,
    booking_availability_type character varying(20) DEFAULT 'all_day'::character varying NOT NULL,
    available_dates text[] DEFAULT '{}'::text[] NOT NULL,
    puja_process_id uuid,
    CONSTRAINT services_booking_availability_type_check CHECK (((booking_availability_type)::text = ANY (ARRAY[('all_day'::character varying)::text, ('specific_day'::character varying)::text])))
);


