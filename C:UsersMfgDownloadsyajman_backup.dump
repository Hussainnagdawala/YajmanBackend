    razorpay_order_id character varying(100),
    razorpay_payment_id character varying(100),
    razorpay_signature character varying(500),
    amount numeric(10,2) NOT NULL,
    currency character varying(5) DEFAULT 'INR'::character varying,
    method character varying(30),
    status public.payment_status DEFAULT 'pending'::public.payment_status NOT NULL,
    error_code character varying(50),
    error_description text,
    error_reason character varying(100),
    paid_at timestamp with time zone,
    refunded_at timestamp with time zone,
    refund_amount numeric(10,2),
    refund_id character varying(100),
    raw_response jsonb,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now()
);


